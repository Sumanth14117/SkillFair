# Copy to .env. Select gemini or groq only after adding that provider's key.
# This example contains placeholders only; never commit a real key.
SKILLFAIR_LLM_PROVIDER=none
SKILLFAIR_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SKILLFAIR_LLM_API_KEY=replace-with-your-google-ai-studio-api-key
SKILLFAIR_LLM_MODEL=gemini-3.8-flash
SKILLFAIR_GEMINI_CONNECT_TIMEOUT_SECONDS=10
SKILLFAIR_GEMINI_RESPONSE_TIMEOUT_SECONDS=120
SKILLFAIR_GROQ_API_KEY=replace-with-your-groq-api-key
SKILLFAIR_GROQ_MODEL=openai/gpt-oss-20b
SKILLFAIR_GROQ_MAX_COMPLETION_TOKENS=8192
SKILLFAIR_GROQ_CONNECT_TIMEOUT_SECONDS=10
SKILLFAIR_GROQ_RESPONSE_TIMEOUT_SECONDS=120
SKILLFAIR_MAX_UPLOAD_BYTES=10485760
SKILLFAIR_MAX_PDF_PAGES=100
SKILLFAIR_MAX_REQUEST_BODY_BYTES=12582912
SKILLFAIR_RATE_LIMIT_PER_MINUTE=60
SKILLFAIR_DISCOVERY_RATE_LIMIT_PER_MINUTE=5
SKILLFAIR_ORCHESTRATOR_RATE_LIMIT_PER_MINUTE=20
SKILLFAIR_AUTH_RATE_LIMIT_PER_MINUTE=10
# Local HTTP development only; set true for HTTPS deployments.
SKILLFAIR_AUTH_COOKIE_SECURE=false
SKILLFAIR_AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DATABASE_URL=postgresql+psycopg://skillfair_app:replace-with-local-password@127.0.0.1:5433/skillfair_db
SKILLFAIR_MIGRATION_DATABASE_URL=postgresql+psycopg://skillfair_migrator:replace-with-migration-password@127.0.0.1:5433/skillfair_db
