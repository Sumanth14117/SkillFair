{
  "name": "skillfair-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/auth-client.test.mjs tests/api-client.test.mjs tests/auth-session-isolation.test.mjs tests/auth-tab-sync.test.mjs tests/session-persistence.test.mjs tests/workflow-restoration.test.mjs tests/workflow-history.test.mjs tests/recruiter-review.test.mjs tests/impact-measurement.test.mjs tests/impact-measurement-ui.test.mjs",
    "test:review": "node --test tests/recruiter-review.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth-client.test.mjs",
    "test:api-client": "node --experimental-strip-types --test tests/api-client.test.mjs",
    "test:identity": "node --experimental-strip-types --test tests/auth-session-isolation.test.mjs tests/auth-tab-sync.test.mjs",
    "test:session": "node --experimental-strip-types --test tests/session-persistence.test.mjs",
    "test:impact": "node --experimental-strip-types --test tests/impact-measurement.test.mjs tests/impact-measurement-ui.test.mjs",
    "test:workflow-restoration": "node --experimental-strip-types --test tests/workflow-restoration.test.mjs",
    "test:workflow-history": "node --experimental-strip-types --test tests/workflow-history.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
